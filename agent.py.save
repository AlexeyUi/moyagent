from datetime import datetime
from uuid import uuid4
from pathlib import Path

import httpx

from agent_protocol import Agent as BaseAgent
from agent_protocol import StepRequestBody, Step

from tools.shell_run import run_safe_shell
from tools.files_write import safe_write_file
from tools.llm_openai import llm_simple_chat

BASE_DIR = Path(__file__).parent  # папка moyagent
NOTES_PATH = BASE_DIR / "notes.txt"
TASKS_PATH = BASE_DIR / "tasks.txt"


class MoyAgent(BaseAgent):
    async def execute_step(self, step_request: StepRequestBody) -> Step:
        now = datetime.now().strftime("%H:%M")
        today_str = datetime.now().strftime("%Y-%m-%d")
        raw_input = step_request.input or ""
        user_input = raw_input.strip().lower()

        # Шаг 1: план + запись в файл
        if user_input in ("", "start", "начать", "план", "plan"):
            plan_text = (
                "✅ Многошаговый режим активирован.\n\n"
                "Шаг 1 — составить план.\n"
                "Шаг 2 — подробно расписать первый пункт.\n\n"
                "Чтобы продолжить, сделай следующий запрос на /steps с input=\"continue\"."
            )

            plan_path = BASE_DIR / "plan.txt"
            plan_path.write_text(plan_text, encoding="utf-8")

            output_text = (
                plan_text
                + "\n\n"
                f"📝 План также сохранён в файл: {plan_path}"
            )

            return Step(
                task_id=step_request.task_id,
                step_id=str(uuid4()),
                name="plan_step",
                input=raw_input,
                additional_input=step_request.additional_input or {},
                output=output_text,
                additional_output={},
                artifacts=[],
                is_last=False,
                status="completed",
            )

        # Шаг 2: детализация плана
        if user_input in ("continue", "продолжить", "дальше"):
            detail_text = (
                "📝 Детализация первого пункта плана.\n\n"
                "1) Оцени, какие задачи реально важные на сегодня.\n"
                "2) Выбери 1–2 главные задачи, а не 10 мелких.\n"
                "3) Разбей каждую задачу на шаги по 10–20 минут.\n\n"
                f"Текущее время: {now}.\n"
                "Если нужно, можешь снова вызвать /steps с другим input — я смогу дополнить."
            )

            return Step(
                task_id=step_request.task_id,
                step_id=str(uuid4()),
                name="detail_step",
                input=raw_input,
                additional_input=step_request.additional_input or {},
                output=detail_text,
                additional_output={},
                artifacts=[],
                is_last=True,
                status="completed",
            )

        # Чтение плана из файла
        if user_input in ("read_plan", "читать план", "показать план"):
            plan_path = BASE_DIR / "plan.txt"
            if plan_path.exists():
                content = plan_path.read_text(encoding="utf-8")
                output_text = "📄 Содержимое plan.txt:\n\n" + content
            else:
                output_text = "⚠️ Файл plan.txt пока не создан."

            return Step(
                task_id=step_request.task_id,
                step_id=str(uuid4()),
                name="read_plan_step",
                input=raw_input,
                additional_input=step_request.additional_input or {},
                output=output_text,
                additional_output={},
                artifacts=[],
                is_last=True,
                status="completed",
            )

        # HTTP-запрос: получить время с публичного API
        if user_input in ("fetch_time", "время", "тайм"):
            try:
                async with httpx.AsyncClient(timeout=5.0) as client:
                    resp = await client.get(
                        "https://worldtimeapi.org/api/timezone/Europe/Amsterdam"
                    )
                data = resp.json()
                datetime_str = data.get("datetime", "неизвестно")
                output_text = (
                    "🌐 Время по данным worldtimeapi.org (Европа/Амстердам):\n\n"
                    f"{datetime_str}"
                )
            except Exception as e:
                output_text = f"⚠️ Не удалось получить время: {e!r}"

            return Step(
                task_id=step_request.task_id,
                step_id=str(uuid4()),
                name="fetch_time_step",
                input=raw_input,
                additional_input=step_request.additional_input or {},
                output=output_text,
                additional_output={},
                artifacts=[],
                is_last=True,
                status="completed",
            )

        # Человеческая команда: shell: <cmd>
        if user_input.startswith("shell:"):
            cmd = raw_input.split(":", 1)[1].strip() if ":" in raw_input else ""
            if not cmd:
                output_text = (
                    "Формат команды:\n"
                    "shell: ls output\n"
                    "shell: cat output/notes/2026-03-27.txt"
                )
            else:
                output_text = run_safe_shell(cmd)

            return Step(
                task_id=step_request.task_id,
                step_id=str(uuid4()),
                name="shell_run_safe_step",
                input=raw_input,
                additional_input=step_request.additional_input or {},
                output=output_text,
                additional_output={},
                artifacts=[],
                is_last=True,
                status="completed",
            )

        # Человеческая команда: write: path ::: content
        if user_input.startswith("write:"):
            try:
                payload = raw_input.split(":", 1)[1].strip()
            except IndexError:
                payload = ""

            if "::: " in payload:
                path_part, content_part = payload.split(":::", 1)
            elif ":::" in payload:
                path_part, content_part = payload.split(":::", 1)
            else:
                path_part, content_part = "", ""

            path_part = path_part.strip()
            content_part = content_part.lstrip()

            if not path_part or not content_part:
                output_text = (
                    "Формат команды:\n"
                    "write: относительный/путь/к_файлу ::: новый текст\n\n"
                    "Примеры:\n"
                    "write: plan.txt ::: Первый пункт\nВторой пункт\n"
                    "write: output/weekend_plan.txt ::: План на выходные..."
                )
            else:
                output_text = safe_write_file(path_part, content_part)

            return Step(
                task_id=step_request.task_id,
                step_id=str(uuid4()),
                name="files_write_human_step",
                input=raw_input,
                additional_input=step_request.additional_input or {},
                output=output_text,
                additional_output={},
                artifacts=[],
                is_last=True,
                status="completed",
            )

        # Человеческая команда: сохрани заметку: текст
        if user_input.startswith("сохрани заметку") or user_input.startswith("save_note"):
            note_text = raw_input.split(":", 1)[1].strip() if ":" in raw_input else ""
            if not note_text:
                output_text = (
                    "✏️ Формат команды:\n"
                    "сохрани заметку: твой текст\n"
                    "Например:\n"
                    "сохрани заметку: сегодня отлично поработал над агентом"
                )
            else:
                # файл вида output/notes/2026-03-27.txt
                notes_dir = BASE_DIR / "output" / "notes"
                notes_dir.mkdir(parents=True, exist_ok=True)
                filename = f"{today_str}.txt"
                target_path = notes_dir / filename

                line = f"[{now}] {note_text}\n"
                try:
                    # дописываем в файл заметок за день
                    with target_path.open("a", encoding="utf-8") as f:
                        f.write(line)
                    output_text = (
                        "✅ Заметка сохранена.\n"
                        f"Файл: output/notes/{filename}\n"
                        f"Текст: {note_text}"
                    )
                except Exception as e:
                    output_text = f"⚠️ Не удалось сохранить заметку: {e!r}"

            return Step(
                task_id=step_request.task_id,
                step_id=str(uuid4()),
                name="save_note_human_step",
                input=raw_input,
                additional_input=step_request.additional_input or {},
                output=output_text,
                additional_output={},
                artifacts=[],
                is_last=True,
                status="completed",
            )

        # Показать заметки за сегодня (output/notes/YYYY-MM-DD.txt)
        if user_input in ("покажи заметки за сегодня", "show_today_notes"):
            notes_file = BASE_DIR / "output" / "notes" / f"{today_str}.txt"
            if not notes_file.exists():
                output_text = "📚 На сегодня ещё нет заметок (файл output/notes не найден)."
            else:
                content = notes_file.read_text(encoding="utf-8")
                if not content.strip():
                    output_text = "📚 Файл заметок за сегодня пуст."
                else:
                    output_text = (
                        f"📚 Заметки за {today_str}:\n\n" + content
                    )

            return Step(
                task_id=step_request.task_id,
                step_id=str(uuid4()),
                name="show_today_notes_step",
                input=raw_input,
                additional_input=step_request.additional_input or {},
                output=output_text,
                additional_output={},
                artifacts=[],
                is_last=True,
                status="completed",
            )

        # Добавить заметку: add_note:текст заметки
        if user_input.startswith("add_note"):
            note_text = raw_input.split(":", 1)[1].strip() if ":" in raw_input else ""
            if not note_text:
                output_text = (
                    "✏️ Чтобы добавить заметку, используй формат:\n"
                    "add_note: твой текст\n"
                    "Например:\n"
                    "add_note: купить хлеб"
                )
            else:
                line = f"[{now}] {note_text}\n"
                with NOTES_PATH.open("a", encoding="utf-8") as f:
                    f.write(line)
                output_text = f"✅ Заметка добавлена: {note_text}"

            return Step(
                task_id=step_request.task_id,
                step_id=str(uuid4()),
                name="add_note_step",
                input=raw_input,
                additional_input=step_request.additional_input or {},
                output=output_text,
                additional_output={},
                artifacts=[],
                is_last=True,
                status="completed",
            )

        # Показать все заметки
        if user_input in ("list_notes", "заметки", "показать заметки"):
            if NOTES_PATH.exists():
                content = NOTES_PATH.read_text(encoding="utf-8")
                if content.strip():
                    output_text = "📚 Твои заметки:\n\n" + content
                else:
                    output_text = "📚 Файл notes.txt пуст."
            else:
                output_text = "📚 Заметок пока нет. Добавь первую через add_note:текст."

            return Step(
                task_id=step_request.task_id,
                step_id=str(uuid4()),
                name="list_notes_step",
                input=raw_input,
                additional_input=step_request.additional_input or {},
                output=output_text,
                additional_output={},
                artifacts=[],
                is_last=True,
                status="completed",
            )

        # Очистить все заметки
        if user_input in ("clear_notes", "очистить заметки"):
            if NOTES_PATH.exists():
                with NOTES_PATH.open("w", encoding="utf-8") as f:
                    f.write("")
                output_text = "🧹 Все заметки очищены (notes.txt теперь пуст)."
            else:
                output_text = "🧹 Файл notes.txt ещё не создан, очищать нечего."

            return Step(
                task_id=step_request.task_id,
                step_id=str(uuid4()),
                name="clear_notes_step",
                input=raw_input,
                additional_input=step_request.additional_input or {},
                output=output_text,
               additional_output={},
                artifacts=[],
                is_last=True,
                status="completed",
            )

        # Удалить последнюю заметку
        if user_input in ("delete_last_note", "удалить последнюю заметку"):
            if NOTES_PATH.exists():
                lines = NOTES_PATH.read_text(encoding="utf-8").splitlines()
                if not lines:
                    output_text = "📂 В notes.txt нет ни одной заметки."
                else:
                    last = lines[-1]
                    new_content = "\n".join(lines[:-1]) + ("\n" if len(lines) > 1 else "")
                    NOTES_PATH.write_text(new_content, encoding="utf-8")
                    output_text = f"🗑️ Удалена последняя заметка:\n{last}"
            else:
                output_text = "📂 Файл notes.txt ещё не создан, удалять нечего."

            return Step(
                task_id=step_request.task_id,
                step_id=str(uuid4()),
                name="delete_last_note_step",
                input=raw_input,
                additional_input=step_request.additional_input or {},
                output=output_text,
               additional_output={},
                artifacts=[],
                is_last=True,
                status="completed",
            )

        # Добавить задачу: add_task: текст | приоритет | дата
        if user_input.startswith("add_task"):
            payload = raw_input.split(":", 1)[1].strip() if ":" in raw_input else ""
            if not payload:
                output_text = (
                    "🧩 Формат добавления задачи:\n"
                    "add_task: текст | приоритет | дата\n"
                    "Например:\n"
                    "add_task: выучить Python | high | 2026-03-27"
                )
            else:
                parts = [p.strip() for p in payload.split("|")]
                text = parts[0] if len(parts) > 0 else ""
                priority = parts[1] if len(parts) > 1 else "normal"
                due = parts[2] if len(parts) > 2 else "без даты"

                if not text:
                    output_text = (
                        "❗ Не вижу текста задачи.\n"
                        "Пример:\n"
                        "add_task: выучить Python | high | 2026-03-27"
                    )
                else:
                    line = f"[ ] {text} | p={priority} | due={due}\n"
                    with TASKS_PATH.open("a", encoding="utf-8") as f:
                        f.write(line)
                    output_text = f"✅ Задача добавлена: {text} (приоритет: {priority}, дата: {due})"

            return Step(
                task_id=step_request.task_id,
                step_id=str(uuid4()),
                name="add_task_step",
                input=raw_input,
                additional_input=step_request.additional_input or {},
                output=output_text,
               additional_output={},
                artifacts=[],
                is_last=True,
                status="completed",
            )

        # Показать все задачи
        if user_input in ("list_tasks", "задачи", "показать задачи"):
            if TASKS_PATH.exists():
                content = TASKS_PATH.read_text(encoding="utf-8").splitlines()
                if not content:
                    output_text = "📋 Список задач пуст."
                else:
                    lines = []
                    for idx, line in enumerate(content, start=1):
                        lines.append(f"{idx}. {line}")
                    output_text = "📋 Твои задачи:\n\n" + "\n".join(lines)
            else:
                output_text = "📋 Файл tasks.txt ещё не создан. Добавь первую задачу через add_task."

            return Step(
                task_id=step_request.task_id,
                step_id=str(uuid4()),
                name="list_tasks_step",
                input=raw_input,
                additional_input=step_request.additional_input or {},
                output=output_text,
               additional_output={},
                artifacts=[],
                is_last=True,
                status="completed",
            )

        # Отметить задачу выполненной по номеру
        if user_input.startswith("done_task"):
            num_str = raw_input.split(":", 1)[1].strip() if ":" in raw_input else ""
            if not num_str:
                output_text = (
                    "✅ Чтобы отметить задачу выполненной, используй формат:\n"
                    "done_task: номер\n"
                    "Например:\n"
                    "done_task: 1"
                )
            else:
                if not TASKS_PATH.exists():
                    output_text = "📋 Файл tasks.txt ещё не создан, задач нет."
                else:
                    try:
                        idx = int(num_str)
                    except ValueError:
                        output_text = f"❌ Номер задачи должен быть числом, а не {num_str!r}."
                    else:
                        lines = TASKS_PATH.read_text(encoding="utf-8").splitlines()
                        if idx < 1 or idx > len(lines):
                            output_text = f"❌ Нет задачи с номером {idx}."
                        else:
                            line = lines[idx - 1]
                            if line.startswith("[x]"):
                                output_text = f"ℹ️ Задача {idx} уже отмечена как выполненная."
                            else:
                                if line.startswith("[ ]"):
                                    new_line = "[x]" + line[3:]
                                else:
                                    new_line = "[x] " + line
                                lines[idx - 1] = new_line
                                TASKS_PATH.write_text("\n".join(lines) + "\n", encoding="utf-8")
                                output_text = f"✅ Задача {idx} отмечена как выполненная:\n{new_line}"

            return Step(
                task_id=step_request.task_id,
                step_id=str(uuid4()),
                name="done_task_step",
                input=raw_input,
                additional_input=step_request.additional_input or {},
                output=output_text,
               additional_output={},
                artifacts=[],
                is_last=True,
                status="completed",
            )

        # Очистить все задачи
        if user_input in ("clear_tasks", "очистить задачи"):
            if TASKS_PATH.exists():
                with TASKS_PATH.open("w", encoding="utf-8") as f:
                    f.write("")
                output_text = "🧹 Все задачи очищены (tasks.txt теперь пуст)."
            else:
                output_text = "🧹 Файл tasks.txt ещё не создан, очищать нечего."

            return Step(
                task_id=step_request.task_id,
                step_id=str(uuid4()),
                name="clear_tasks_step",
                input=raw_input,
                additional_input=step_request.additional_input or {},
                output=output_text,
               additional_output={},
                artifacts=[],
                is_last=True,
                status="completed",
            )

        # Показать задачи по приоритету
        if user_input.startswith("filter_tasks"):
            prio = raw_input.split(":", 1)[1].strip() if ":" in raw_input else ""
            if not prio:
                output_text = (
                    "🎯 Формат фильтра по приоритету:\n"
                    "filter_tasks: приоритет\n"
                    "Например:\n"
                    "filter_tasks: high"
                )
            else:
                if not TASKS_PATH.exists():
                    output_text = "📋 Файл tasks.txt ещё не создан, задач нет."
                else:
                    lines = TASKS_PATH.read_text(encoding="utf-8").splitlines()
                    matched = [l for l in lines if f"p={prio}" in l]
                    if not matched:
                        output_text = f"📋 Задач с приоритетом {prio!r} не найдено."
                    else:
                        numbered = [f"{i+1}. {line}" for i, line in enumerate(matched)]
                        output_text = f"📋 Задачи с приоритетом {prio}:\n\n" + "\n".join(numbered)

            return Step(
                task_id=step_request.task_id,
                step_id=str(uuid4()),
                name="filter_tasks_step",
                input=raw_input,
                additional_input=step_request.additional_input or {},
                output=output_text,
               additional_output={},
                artifacts=[],
                is_last=True,
                status="completed",
            )

        # Авто-план на сегодня
        if user_input.startswith("plan_today"):
            payload = raw_input.split(":", 1)[1].strip() if ":" in raw_input else ""
            if not payload:
                output_text = (
                    "📆 Формат команды plan_today:\n"
                    "plan_today: задача1; задача2; задача3\n"
                    "Например:\n"
                    "plan_today: спорт; работа над агентом; отдых"
                )
            else:
                today = today_str
                parts = [p.strip() for p in payload.split(";") if p.strip()]
                if not parts:
                    output_text = (
                        "❗ Не смог выделить ни одной задачи.\n"
                        "Пример:\n"
                        "plan_today: спорт; работа над агентом; отдых"
                    )
                else:
                    lines = []
                    for text in parts:
                        line = f"[ ] {text} | p=normal | due={today}\n"
                        lines.append(line)
                    with TASKS_PATH.open("a", encoding="utf-8") as f:
                        f.writelines(lines)
                    output_text = (
                        "✅ План на сегодня создан. Добавлены задачи:\n\n"
                        + "".join(lines)
                    )

            return Step(
                task_id=step_request.task_id,
                step_id=str(uuid4()),
                name="plan_today_step",
                input=raw_input,
                additional_input=step_request.additional_input or {},
                output=output_text,
               additional_output={},
                artifacts=[],
                is_last=True,
                status="completed",
            )

        # Умный анализ дня по задачам
        if user_input in ("analyze_day", "анализ дня", "анализ задач"):
            if not TASKS_PATH.exists():
                output_text = "📋 У тебя пока нет задач (tasks.txt). Сначала добавь хотя бы одну через add_task или plan_today."
            else:
                lines = TASKS_PATH.read_text(encoding="utf-8").splitlines()
                if not lines:
                    output_text = "📋 Список задач пуст. Нечего анализировать."
                else:
                    overdue = []
                    today = []
                    future = []
                    completed = []

                    for line in lines:
                        is_done = line.startswith("[x]")
                        due_part = "due=без даты"
                        if "due=" in line:
                            due_part = line.split("due=", 1)[1].strip()
                        due_date = due_part

                        if is_done:
                            completed.append(line)
                            continue

                        if due_date == "без даты":
                            future.append(line)
                            continue

                        try:
                            if due_date < today_str:
                                overdue.append(line)
                            elif due_date == today_str:
                                today.append(line)
                            else:
                                future.append(line)
                        except Exception:
                            future.append(line)

                    parts = ["🧠 Анализ твоих задач:"]
                    if overdue:
                        parts.append("\n🔥 Просроченные задачи (сначала разберись с ними):")
                        for l in overdue:
                            parts.append(f"- {l}")
                    if today:
                        parts.append("\n✅ На сегодня (главный фокус дня):")
                        for l in today:
                            parts.append(f"- {l}")
                    if future:
                        parts.append("\n📅 На потом (можно не трогать сегодня):")
                        for l in future:
                            parts.append(f"- {l}")
                    if completed:
                        parts.append("\n🎉 Уже сделано (можно собой гордиться):")
                        for l in completed:
                            parts.append(f"- {l}")

                    output_text = "\n".join(parts)

            return Step(
                task_id=step_request.task_id,
                step_id=str(uuid4()),
                name="analyze_day_step",
                input=raw_input,
                additional_input=step_request.additional_input or {},
                output=output_text,
               additional_output={},
                artifacts=[],
                is_last=True,
                status="completed",
            )

        # Запись произвольного файла: write_file: путь | текст
        if user_input.startswith("write_file"):
            payload = raw_input.split(":", 1)[1].strip() if ":" in raw_input else ""
            if not payload:
                output_text = (
                    "📁 Формат команды записи файла:\n"
                    "write_file: путь | текст\n"
                    "Например:\n"
                    "write_file: output/notes/today.txt | Это моя заметка.\n"
                )
            else:
                parts = [p.strip() for p in payload.split("|", 1)]
                path = parts[0] if len(parts) > 0 else ""
                content = parts[1] if len(parts) > 1 else ""

                if not path or not content:
                    output_text = (
                        "❗ Нужно указать и путь, и текст.\n"
                        "Пример:\n"
                        "write_file: output/notes/today.txt | Это моя заметка.\n"
                    )
                else:
                    try:
                        result_msg = write_file(path, content)
                        output_text = f"✅ {result_msg}"
                    except Exception as e:
                        output_text = f"⚠️ Не удалось записать файл: {e!r}"

            return Step(
                task_id=step_request.task_id,
                step_id=str(uuid4()),
                name="write_file_step",
                input=raw_input,
                additional_input=step_request.additional_input or {},
                output=output_text,
               additional_output={},
                artifacts=[],
                is_last=True,
                status="completed",
            )

        # Чтение произвольного файла: read_file: путь
        if user_input.startswith("read_file"):
            path = raw_input.split(":", 1)[1].strip() if ":" in raw_input else ""
            if not path:
                output_text = (
                    "📖 Формат команды чтения файла:\n"
                    "read_file: путь\n"
                    "Например:\n"
                    "read_file: output/weekend_plan.txt\n"
                )
            else:
                target_path = (BASE_DIR / path).resolve()
                if BASE_DIR not in target_path.parents and BASE_DIR != target_path:
                    output_text = "🚫 Нельзя читать файлы вне папки агента."
                else:
                    if not target_path.exists():
                        output_text = f"⚠️ Файл не найден: {target_path}"
                    else:
                        try:
                            content = target_path.read_text(encoding="utf-8")
                            output_text = f"📄 Содержимое {path}:\n\n" + content
                        except Exception as e:
                            output_text = f"⚠️ Не удалось прочитать файл: {e!r}"

            return Step(
                task_id=step_request.task_id,
                step_id=str(uuid4()),
                name="read_file_step",
                input=raw_input,
                additional_input=step_request.additional_input or {},
                output=output_text,
               additional_output={},
                artifacts=[],
                is_last=True,
                status="completed",
            )

        # Свободный LLM-режим: llm: твой вопрос
        if user_input.startswith("llm:"):
            query = raw_input.split(":", 1)[1].strip() if ":" in raw_input else ""
            if not query:
                output_text = (
                    "Формат команды:\n"
                    "llm: твой вопрос\n\n"
                    "Например:\n"
                    "llm: объясни, что такое многопоточное программирование простыми словами"
                )
            else:
                prompt = [
                    {
                        "role": "system",
                        "content": (
                            "Ты — умный ассистент по имени MoyAgent. "
                            "Отвечай кратко, по существу, на русском языке."
                        ),
                    },
                    {
                        "role": "user",
                        "content": query,
                    },
                ]
                try:
                    answer = llm_simple_chat(prompt)
                    output_text = answer
                except Exception as e:
                    output_text = f"⚠️ Ошибка LLM: {e!r}"

            return Step(
                task_id=step_request.task_id,
                step_id=str(uuid4()),
                name="llm_free_chat_step",
                input=raw_input,
                additional_input=step_request.additional_input or {},
                output=output_text,
                additional_output={},
                artifacts=[],
                is_last=True,
                status="completed",
            )

        # Режим "диспетчера": ai: ... -> LLM решает, что вызвать
        if user_input.startswith("ai:"):
            query = raw_input.split(":", 1)[1].strip() if ":" in raw_input else ""
            if not query:
                output_text = (
                    "Формат команды:\n"
                    "ai: твоя фраза на русском\n\n"
                    "Например:\n"
                    "ai: добавь задачу купить хлеб сегодня\n"
                    "ai: покажи мои заметки\n"
                    "ai: запиши в plan.txt пункт про LLM"
                )
                return Step(
                    task_id=step_request.task_id,
                    step_id=str(uuid4()),
                    name="ai_router_help",
                    input=raw_input,
                    additional_input=step_request.additional_input or {},
                    output=output_text,
                    additional_output={},
                    artifacts=[],
                    is_last=True,
                    status="completed",
                )

            # 1) Попросим LLM решить, какую команду вызвать
            route = llm_route_command(query)
            cmd = route.get("command", "none")
            args = route.get("args", {}) or {}

            # 2) На основе cmd сами вызываем уже существующую логику

            # add_note
            if cmd == "add_note":
                note_text = args.get("text") or query
                step_request.input = f"add_note: {note_text}"
                return await self.execute_step(step_request)

            # add_task
            if cmd == "add_task":
                text = args.get("text") or query
                priority = args.get("priority") or "normal"
                due = args.get("due") or "без даты"
                step_request.input = f"add_task: {text} | {priority} | {due}"
                return await self.execute_step(step_request)

            # list_tasks
            if cmd == "list_tasks":
                step_request.input = "list_tasks"
                return await self.execute_step(step_request)

            # list_notes
            if cmd == "list_notes":
                step_request.input = "list_notes"
                return await self.execute_step(step_request)

            # по умолчанию — просто ответ от LLM как чат
            prompt = [
                {
                    "role": "system",
                    "content": (
                        "Ты — ассистент MoyAgent. Команда распознана как 'none', "
                        "поэтому просто ответь по-человечески на русском."
                    ),
                },
                {"role": "user", "content": query},
            ]
            try:
                answer = llm_simple_chat(prompt)
                output_text = answer
            except Exception as e:
                output_text = f"⚠️ Ошибка LLM (router fallback): {e!r}"

            return Step(
                task_id=step_request.task_id,
                step_id=str(uuid4()),
                name="ai_router_fallback",
                input=raw_input,
                additional_input=step_request.additional_input or {},
                output=output_text,
                additional_output={},
                artifacts=[],
                is_last=True,
                status="completed",
            )

        # Поведение по умолчанию
        default_text = (
            "🤔 Я в многошаговом режиме, но не понял команду.\n\n"
            "Попробуй одно из:\n"
            "- \"start\" или \"начать\" — план из двух шагов\n"
            "- \"continue\" или \"продолжить\" — детализация плана\n"
            "- \"read_plan\" — показать содержимое plan.txt\n"
            "- \"fetch_time\" — получить время с публичного API\n"
            "- \"add_note: текст\" — добавить заметку\n"
            "- \"list_notes\" — показать все заметки\n"
            "- \"clear_notes\" — очистить все заметки\n"
            "- \"delete_last_note\" — удалить последнюю заметку\n"
            "- \"add_task: текст | приоритет | дата\" — добавить задачу\n"
            "- \"list_tasks\" — показать все задачи\n"
            "- \"done_task: номер\" — отметить задачу выполненной\n"
            "- \"clear_tasks\" — очистить все задачи\n"
            "- \"filter_tasks: приоритет\" — задачи по приоритету\n"
            "- \"plan_today: задача1; задача2; ...\" — запланировать день\n"
            "- \"analyze_day\" — умный анализ задач на сегодня\n"
            "- \"write_file: путь | текст\" — записать файл\n"
            "- \"read_file: путь\" — прочитать файл\n\n"
            f"Ты прислал: {step_request.input!r}"
        )

        return Step(
            task_id=step_request.task_id,
            step_id=str(uuid4()),
            name="unknown_command",
            input=raw_input,
            additional_input=step_request.additional_input or {},
            output=default_text,
           additional_output={},
            artifacts=[],
            is_last=True,
            status="completed",
        )

